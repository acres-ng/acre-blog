# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined into the
# bundle at build time, so nothing secret belongs under that prefix.
#
# These must also be set on the deployment (Vercel project settings). An unset
# var here does not fail the build — the navbar and footer just render without
# whatever it fed, which is how the live footer ended up with no address, no
# social icons and no Download App column.

# --- Strapi (blog content) ---
NEXT_PUBLIC_STRAPI_URL=
STRAPI_API_TOKEN=
STRAPI_HOSTNAME=
STRAPI_REVALIDATE_SECRET=
STRAPI_DRAFT_SECRET=

# --- Acre API ---
# Source of the footer's address, social icons, store links and legal links.
# When this is unset, acreGet throws, getAppSettings swallows it and returns
# null, and every one of those sections disappears from the footer.
NEXT_PUBLIC_ACRE_API_URL=https://app.acre-life.com/api/v1

# --- The web app ---
# Every cross-property link in the navbar and footer is built from this.
# lib/env.ts defaults it to the production site, so leaving it blank is safe.
ACRE_WEBSITE_URL=https://www.acre-life.com
ACRE_EMAIL=

# --- Fallbacks used only when the Acre API does not answer ---
ACRE_ONE_LINK=
PLAYSTORE_APP_LINK=
APP_STORE_APP_LINK=
SOCIAL_WHATSAPP=
SOCIAL_LINKEDIN=
SOCIAL_FACEBOOK=
SOCIAL_TWITTER=

LOG_LEVEL=
